    "setup-db": "node scripts/setup-database.js",
    "setup-db:seed": "node scripts/setup-database.js --seed",
    "db:migrate": "node src/database/migrator.js up",
    "db:migrate:reset-005": "node -e \"const db = require('./src/database/db-manager-v2').getInstance(); db.db.prepare('DELETE FROM migrations WHERE name = ?').run('005_add_unified_flow.sql'); console.log('Migration 005 reset - will run again on next migration');\"",
    "db:verify": "node scripts/verify-db-sync.js",
    "db:create-admin": "node scripts/create-admin-user.js",
    "db:access": "node scripts/db-access.js",
    "db:migrate:status": "node src/database/migrator.js status",
    "db:migrate:rollback": "node src/database/migrator.js down",
    "db:seed": "node src/database/seeds/seed.js",
    "test": "jest",
    "test:unit": "jest tests/unit",
    "test:integration": "jest tests/integration",
    "test:unified": "node tests/unified-flow.test.js",
    "test:security": "jest tests/security",
    "test:load": "node tests/performance/load-test.js",
    "test:coverage": "jest --coverage",
    "test-project": "node scripts/test-project.js",
    "generate-report": "node scripts/generate-report.js",
    "quick-test": "node scripts/quick-test.js",
    "validate": "node scripts/validate-day1.js",
    "test:verify": "node scripts/test-verification.js",
    "test:full-stack": "node scripts/full-stack-verification.js",
    "test:verification": "node scripts/full-stack-verification.js",
    "docs:validate": "node scripts/validate-docs.js",
    "docs:metrics": "node scripts/compute-doc-metrics.js",
    "docs:regression": "node scripts/regression-test.js",
    "docs:golden": "node scripts/generate-golden-scopes.js",
    "docs:measure": "node scripts/measure-doc-gen.js"
