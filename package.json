{
  "name": "scogen",
  "version": "1.0.0",
  "description": "AI-powered development scoping tool",
  "main": "src/index.js",
  "scripts": {
    "start": "node scripts/start.js",
    "setup": "node scripts/setup.js",
    "web": "node src/web-server.js",
