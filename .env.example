# SCOGEN Platform Configuration

# Database Configuration
DATABASE_PATH=./data/scogen.db
NEW_DB_PATH=./data/scogen_v2.db
OLD_DB_PATH=./data/scogen.db

# Feature Flags (Gradual Rollout)
# Set to 'true' to enable new features
USE_NEW_DB=false
USE_QUALITY_ANALYSIS=false

# Database Migration Mode
# Options: parallel | new | old
DB_MIGRATION_MODE=parallel

# Auto-run migrations on server startup (optional)
RUN_MIGRATIONS=false

# Trust Scoring & Smart Routing (Feature Flags)
# Set to 'true' to enable enhanced trust scoring and routing
ENABLE_TRUST_SCORING=false
ENABLE_SMART_ROUTING=false

# Full Chain Execution (Steps 1-5)
# Set to 'true' to enable all steps: Trust → Enrichment → Decomposition → Risk → Scenarios
ENABLE_FULL_CHAIN=false

# Individual Step Flags (optional, for gradual rollout)
# These are automatically enabled if ENABLE_FULL_CHAIN=true
ENABLE_REQUIREMENTS_ENRICHMENT=false
ENABLE_TECHNICAL_DECOMPOSITION=false
ENABLE_RISK_ASSESSMENT=false
ENABLE_SCENARIO_GENERATION=false

# OpenAI API Configuration
OPENAI_API_KEY=your_api_key_here

# Server Configuration
PORT=3000
NODE_ENV=development

# Logging
LOG_LEVEL=info

