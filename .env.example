# Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=scogen
POSTGRES_USER=scogen
POSTGRES_PASSWORD=changeme

# MinIO (S3-Compatible Storage)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=changeme
MINIO_BUCKET=scogen-assets
MINIO_USE_SSL=false

# Ollama (Local LLM)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3:70b
OLLAMA_CONTEXT_WINDOW=8192

# Whisper (Speech-to-Text)
WHISPER_MODEL=large-v3
WHISPER_DEVICE=cuda

# Application
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_URL=http://localhost:3000
DEBUG=false

# Security
JWT_SECRET=changeme-generate-secure-secret
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Pricing Engine
DEFAULT_MARKET_HOURLY_RATE=2500
MINIMUM_MARGIN_PERCENTAGE=40
RISK_BUFFER_PERCENTAGE=20

# Feature Flags
ENABLE_VOICE_INPUT=true
ENABLE_SHADOW_PRICING=true
ENABLE_MATURITY_SCORING=true
